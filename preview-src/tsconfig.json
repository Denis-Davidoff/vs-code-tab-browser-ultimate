{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		// ".." and not ".": `chat.ts` reads the message types from
		// `../src/chat/chatProtocol.ts` with `import type`. Nothing is emitted from
		// this project (esbuild bundles it), so the wider root changes no output.
		"rootDir": "..",
		"outDir": "./dist/",
		"lib": [
			"ES2024",
			"DOM",
			"DOM.Iterable"
		],
		"typeRoots": [
			"../node_modules/@types"
		],
		"allowImportingTsExtensions": true
	}
}
