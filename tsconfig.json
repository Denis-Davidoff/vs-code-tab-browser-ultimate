{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out",
		"types": [
			"node"
		],
		"typeRoots": [
			"./node_modules/@types"
		]
	},
	"exclude": [
		"**/*.test.ts"
	],
	"include": [
		"src/**/*",
		"node_modules/@types/vscode/index.d.ts",
		"vscode.proposed.externalUriOpener.d.ts",
		"vscode.proposed.browser.d.ts"
	]
}
