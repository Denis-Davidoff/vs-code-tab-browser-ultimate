		"configuration": [
			{
				"title": "AI Browser",
				"properties": {
					"aiBrowser.useIntegratedBrowser": {
						"type": "boolean",
						"default": true,
						"title": "Use Integrated Browser",
						"description": "%configuration.useIntegratedBrowser.description%"
					},
					"aiBrowser.focusLockIndicator.enabled": {
						"type": "boolean",
						"default": true,
						"title": "Focus Lock Indicator Enabled",
						"description": "%configuration.focusLockIndicator.enabled.description%"
					},
					"aiBrowser.searchEngine": {
						"type": "string",
						"enum": [
							"none",
							"bing",
							"google",
							"yahoo",
							"duckduckgo"
						],
						"default": "google",
						"title": "Search Engine",
						"description": "%configuration.searchEngine.description%"
					},
					"aiBrowser.mcp.enabled": {
						"type": "boolean",
						"default": true,
						"title": "MCP Server Enabled",
						"markdownDescription": "%configuration.mcp.enabled.description%"
					},
					"aiBrowser.updateCheck.enabled": {
					"type": "boolean",
					"default": true,
					"title": "Check For Updates",
					"markdownDescription": "%configuration.updateCheck.enabled.description%"
				},
				"aiBrowser.mcp.port": {
						"type": "number",
						"default": 43110,
						"minimum": 1024,
						"maximum": 65535,
						"title": "MCP Server Port",
						"markdownDescription": "%configuration.mcp.port.description%"
					}
				}
			}
		],
		"menus": {
			"editor/title": [
				{
					"submenu": "aiBrowser.elementMenu",
					"group": "navigation@1",
					"when": "activeEditor == 'workbench.editor.browser'"
				},
				{
					"command": "aiBrowser.repeat.element",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'element'"
				},
				{
					"command": "aiBrowser.repeat.cssPath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'cssPath'"
				},
				{
					"command": "aiBrowser.repeat.cssLocation",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'cssLocation'"
				},
				{
					"command": "aiBrowser.repeat.xpath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'xpath'"
				},
				{
					"command": "aiBrowser.repeat.claude.element",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:element' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.repeat.claude.cssPath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:cssPath' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.repeat.claude.cssLocation",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:cssLocation' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.repeat.claude.xpath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:xpath' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.repeat.codex.element",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:element' && aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.repeat.codex.cssPath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:cssPath' && aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.repeat.codex.cssLocation",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:cssLocation' && aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.repeat.codex.xpath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:xpath' && aiBrowser.codexInstalled"
				}
			],
			"aiBrowser.elementMenu": [
				{
					"command": "aiBrowser.copyElement",
					"group": "1_copy@1"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "1_copy@2"
				},
				{
					"command": "aiBrowser.copyElementCssLocation",
					"group": "1_copy@3"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "1_copy@4"
				},
				{
					"command": "aiBrowser.copyScreenshot",
					"group": "2_shot@1"
				},
				{
					"command": "aiBrowser.copyFullScreenshot",
					"group": "2_shot@2"
				},
				{
					"submenu": "aiBrowser.claudeMenu",
					"group": "3_assistant@1"
				},
				{
					"submenu": "aiBrowser.codexMenu",
					"group": "3_assistant@2"
				},
				{
					"command": "aiBrowser.checkMcpConnection",
					"group": "3_assistant@3"
				},
				{
					"command": "aiBrowser.shareTab",
					"group": "4_share@1"
				},
				{
					"command": "aiBrowser.stopSharingTab",
					"group": "4_share@2",
					"when": "aiBrowser.tabShared"
				}
			],
			"commandPalette": [
				{
					"command": "aiBrowser.repeat.element",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.cssPath",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.cssLocation",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.xpath",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.claude.element",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.claude.cssPath",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.claude.cssLocation",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.claude.xpath",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.codex.element",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.codex.cssPath",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.codex.cssLocation",
					"when": "false"
				},
				{
					"command": "aiBrowser.repeat.codex.xpath",
					"when": "false"
				}
			],
			"aiBrowser.claudeMenu": [
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "1_add@1",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "1_add@2",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssLocationToClaudeCode",
					"group": "1_add@3",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "1_add@4",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.connectClaudeCode",
					"group": "2_mcp@1"
				},
				{
					"command": "aiBrowser.shareTabWithClaudeCode",
					"group": "2_mcp@2"
				}
			],
			"aiBrowser.codexMenu": [
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "1_add@1",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "1_add@2",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssLocationToCodex",
					"group": "1_add@3",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "1_add@4",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.connectCodex",
					"group": "2_mcp@1"
				},
				{
					"command": "aiBrowser.shareTabWithCodex",
					"group": "2_mcp@2"
				}
			]
		},
		"submenus": [
			{
				"id": "aiBrowser.elementMenu",
