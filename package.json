{
	"name": "ai-browser",
	"displayName": "%displayName%",
	"description": "%description%",
	"enabledApiProposals": [
		"externalUriOpener",
		"browser"
	],
	"version": "0.0.1",
	"icon": "media/icon.png",
	"publisher": "DenysDavydov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Denis-Davidoff/ai-browser.git"
	},
	"engines": {
		"vscode": "^1.136.0"
	},
	"main": "./out/extension",
	"categories": [
		"Other"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [
		"onCommand:aiBrowser.show",
		"onCommand:aiBrowser.api.open",
		"onCommand:aiBrowser.copyElementXPath",
		"onOpenExternalUri:http",
		"onOpenExternalUri:https",
		"onWebviewPanel:aiBrowser.view",
		"onCommand:aiBrowser.copyElement",
		"onCommand:aiBrowser.copyElementCssPath",
		"onStartupFinished",
		"onCommand:aiBrowser.connectClaudeCode",
		"onCommand:aiBrowser.connectCodex",
		"onCommand:aiBrowser.checkMcpConnection",
		"onCommand:aiBrowser.addElementToClaudeCode",
		"onCommand:aiBrowser.addCssPathToClaudeCode",
		"onCommand:aiBrowser.addXPathToClaudeCode",
		"onCommand:aiBrowser.addElementToCodex",
		"onCommand:aiBrowser.addCssPathToCodex",
		"onCommand:aiBrowser.addXPathToCodex"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "aiBrowser.show",
				"title": "Show",
				"category": "AI Browser"
			},
			{
				"command": "aiBrowser.copyElementXPath",
				"title": "%command.copyElementXPath.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-green-light.svg",
					"dark": "media/icons/crosshair-green-dark.svg"
				}
			},
			{
				"command": "aiBrowser.copyElement",
				"title": "%command.copyElement.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-red-light.svg",
					"dark": "media/icons/crosshair-red-dark.svg"
				}
			},
			{
				"command": "aiBrowser.copyElementCssPath",
				"title": "%command.copyElementCssPath.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-blue-light.svg",
					"dark": "media/icons/crosshair-blue-dark.svg"
				}
			},
			{
				"command": "aiBrowser.connectClaudeCode",
				"title": "%command.connectClaudeCode.title%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "aiBrowser.connectCodex",
				"title": "%command.connectCodex.title%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "aiBrowser.checkMcpConnection",
				"title": "%command.checkMcpConnection.title%",
				"category": "%displayName%",
				"icon": "$(pulse)"
			},
			{
				"command": "aiBrowser.addElementToClaudeCode",
				"title": "%command.addElementToClaudeCode.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-red-light.svg",
					"dark": "media/icons/crosshair-red-dark.svg"
				}
			},
			{
				"command": "aiBrowser.addCssPathToClaudeCode",
				"title": "%command.addCssPathToClaudeCode.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-blue-light.svg",
					"dark": "media/icons/crosshair-blue-dark.svg"
				}
			},
			{
				"command": "aiBrowser.addXPathToClaudeCode",
				"title": "%command.addXPathToClaudeCode.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-green-light.svg",
					"dark": "media/icons/crosshair-green-dark.svg"
				}
			},
			{
				"command": "aiBrowser.addElementToCodex",
				"title": "%command.addElementToCodex.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-red-light.svg",
					"dark": "media/icons/crosshair-red-dark.svg"
				}
			},
			{
				"command": "aiBrowser.addCssPathToCodex",
				"title": "%command.addCssPathToCodex.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-blue-light.svg",
					"dark": "media/icons/crosshair-blue-dark.svg"
				}
			},
			{
				"command": "aiBrowser.addXPathToCodex",
				"title": "%command.addXPathToCodex.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-green-light.svg",
					"dark": "media/icons/crosshair-green-dark.svg"
				}
			}
		],
		"configuration": [
			{
				"title": "AI Browser",
				"properties": {
					"aiBrowser.useIntegratedBrowser": {
						"type": "boolean",
						"default": true,
						"title": "Use Integrated Browser",
						"description": "%configuration.useIntegratedBrowser.description%"
					},
					"aiBrowser.focusLockIndicator.enabled": {
						"type": "boolean",
						"default": true,
						"title": "Focus Lock Indicator Enabled",
						"description": "%configuration.focusLockIndicator.enabled.description%"
					},
					"aiBrowser.searchEngine": {
						"type": "string",
						"enum": [
							"none",
							"bing",
							"google",
							"yahoo",
							"duckduckgo"
						],
						"default": "google",
						"title": "Search Engine",
						"description": "%configuration.searchEngine.description%"
					},
					"aiBrowser.mcp.enabled": {
						"type": "boolean",
						"default": true,
						"title": "MCP Server Enabled",
						"markdownDescription": "%configuration.mcp.enabled.description%"
					},
					"aiBrowser.mcp.port": {
						"type": "number",
						"default": 43110,
						"minimum": 1024,
						"maximum": 65535,
						"title": "MCP Server Port",
						"markdownDescription": "%configuration.mcp.port.description%"
					}
				}
			}
		],
		"menus": {
			"editor/title": [
				{
					"submenu": "aiBrowser.elementMenu",
					"group": "navigation@1",
					"when": "activeEditor == 'workbench.editor.browser' && !aiBrowser.claudeConnected && !aiBrowser.codexConnected"
				},
				{
					"submenu": "aiBrowser.elementMenuClaude",
					"group": "navigation@1",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.claudeConnected && !aiBrowser.codexConnected"
				},
				{
					"submenu": "aiBrowser.elementMenuCodex",
					"group": "navigation@1",
					"when": "activeEditor == 'workbench.editor.browser' && !aiBrowser.claudeConnected && aiBrowser.codexConnected"
				},
				{
					"submenu": "aiBrowser.elementMenuBoth",
					"group": "navigation@1",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.claudeConnected && aiBrowser.codexConnected"
				},
				{
					"command": "aiBrowser.copyElement",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'element'"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'cssPath'"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'xpath'"
				},
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:element' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:cssPath' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'claude:xpath' && aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:element' && aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:cssPath' && aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "navigation@2",
					"when": "activeEditor == 'workbench.editor.browser' && aiBrowser.lastElementAction == 'codex:xpath' && aiBrowser.codexInstalled"
				}
			],
			"aiBrowser.elementMenu": [
				{
					"command": "aiBrowser.copyElement",
					"group": "1_copy@1"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "1_copy@2"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "1_copy@3"
				},
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "2_claude@1",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "2_claude@2",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "2_claude@3",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "3_codex@1",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "3_codex@2",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "3_codex@3",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.connectClaudeCode",
					"group": "4_mcp@1"
				},
				{
					"command": "aiBrowser.connectCodex",
					"group": "4_mcp@2"
				},
				{
					"command": "aiBrowser.checkMcpConnection",
					"group": "4_mcp@3"
				}
			],
			"aiBrowser.elementMenuClaude": [
				{
					"command": "aiBrowser.copyElement",
					"group": "1_copy@1"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "1_copy@2"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "1_copy@3"
				},
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "2_claude@1",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "2_claude@2",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "2_claude@3",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "3_codex@1",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "3_codex@2",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "3_codex@3",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.connectClaudeCode",
					"group": "4_mcp@1"
				},
				{
					"command": "aiBrowser.connectCodex",
					"group": "4_mcp@2"
				},
				{
					"command": "aiBrowser.checkMcpConnection",
					"group": "4_mcp@3"
				}
			],
			"aiBrowser.elementMenuCodex": [
				{
					"command": "aiBrowser.copyElement",
					"group": "1_copy@1"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "1_copy@2"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "1_copy@3"
				},
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "2_claude@1",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "2_claude@2",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "2_claude@3",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "3_codex@1",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "3_codex@2",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "3_codex@3",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.connectClaudeCode",
					"group": "4_mcp@1"
				},
				{
					"command": "aiBrowser.connectCodex",
					"group": "4_mcp@2"
				},
				{
					"command": "aiBrowser.checkMcpConnection",
					"group": "4_mcp@3"
				}
			],
			"aiBrowser.elementMenuBoth": [
				{
					"command": "aiBrowser.copyElement",
					"group": "1_copy@1"
				},
				{
					"command": "aiBrowser.copyElementCssPath",
					"group": "1_copy@2"
				},
				{
					"command": "aiBrowser.copyElementXPath",
					"group": "1_copy@3"
				},
				{
					"command": "aiBrowser.addElementToClaudeCode",
					"group": "2_claude@1",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToClaudeCode",
					"group": "2_claude@2",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addXPathToClaudeCode",
					"group": "2_claude@3",
					"when": "aiBrowser.claudeInstalled"
				},
				{
					"command": "aiBrowser.addElementToCodex",
					"group": "3_codex@1",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addCssPathToCodex",
					"group": "3_codex@2",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.addXPathToCodex",
					"group": "3_codex@3",
					"when": "aiBrowser.codexInstalled"
				},
				{
					"command": "aiBrowser.connectClaudeCode",
					"group": "4_mcp@1"
				},
				{
					"command": "aiBrowser.connectCodex",
					"group": "4_mcp@2"
				},
				{
					"command": "aiBrowser.checkMcpConnection",
					"group": "4_mcp@3"
				}
			]
		},
		"submenus": [
			{
				"id": "aiBrowser.elementMenu",
				"label": "%submenu.elementMenu.label%",
				"icon": {
					"light": "media/icons/globe-light.svg",
					"dark": "media/icons/globe-dark.svg"
				}
			},
			{
				"id": "aiBrowser.elementMenuClaude",
				"label": "%submenu.elementMenu.label%",
				"icon": {
					"light": "media/icons/globe-claude-light.svg",
					"dark": "media/icons/globe-claude-dark.svg"
				}
			},
			{
				"id": "aiBrowser.elementMenuCodex",
				"label": "%submenu.elementMenu.label%",
				"icon": {
					"light": "media/icons/globe-codex-light.svg",
					"dark": "media/icons/globe-codex-dark.svg"
				}
			},
			{
				"id": "aiBrowser.elementMenuBoth",
				"label": "%submenu.elementMenu.label%",
				"icon": {
					"light": "media/icons/globe-both-light.svg",
					"dark": "media/icons/globe-both-dark.svg"
				}
			}
		],
		"mcpServerDefinitionProviders": [
			{
				"id": "aiBrowserMcp",
				"label": "AI Browser"
			}
		]
	},
	"scripts": {
		"compile": "npm run build-ext && npm run build-webview",
		"watch": "run-p -l watch-ext watch-webview watch-typecheck-webview",
		"build-ext": "tsc --project ./tsconfig.json",
		"build-webview": "node ./esbuild.webview.mts",
		"watch-ext": "tsc --project ./tsconfig.json --watch",
		"watch-webview": "node ./esbuild.webview.mts --watch",
		"watch-typecheck-webview": "tsc --project ./preview-src/tsconfig.json --noEmit --watch",
		"typecheck": "run-p -l typecheck-ext typecheck-webview typecheck-tests",
		"typecheck-ext": "tsc --project ./tsconfig.json --noEmit",
		"typecheck-webview": "tsc --project ./preview-src/tsconfig.json --noEmit",
		"typecheck-tests": "tsc --project ./tsconfig.test.json",
		"test": "node --test preview-src/*.test.ts src/*.test.ts",
		"package": "vsce package --no-dependencies --out ai-browser.vsix",
		"download-api": "dts dev",
		"vscode:prepublish": "npm run compile"
	},
	"devDependencies": {
		"@types/node": "24.x",
		"@types/vscode": "^1.136.0",
		"@vscode/codicons": "^0.0.36",
		"@vscode/dts": "^0.4.1",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"npm-run-all2": "^9.0.3",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
