	"scripts": {
		"compile": "npm run build-ext && npm run build-webview",
		"watch": "run-p -l watch-ext watch-webview watch-typecheck-webview",
		"build-ext": "npm run clean-ext && tsc --project ./tsconfig.json",
		"build-webview": "node ./esbuild.webview.mts",
		"watch-ext": "tsc --project ./tsconfig.json --watch",
		"watch-webview": "node ./esbuild.webview.mts --watch",
		"watch-typecheck-webview": "tsc --project ./preview-src/tsconfig.json --noEmit --watch",
		"typecheck": "run-p -l typecheck-ext typecheck-webview typecheck-tests",
		"typecheck-ext": "tsc --project ./tsconfig.json --noEmit",
		"typecheck-webview": "tsc --project ./preview-src/tsconfig.json --noEmit",
		"typecheck-tests": "tsc --project ./tsconfig.test.json",
		"test": "node --test \"preview-src/**/*.test.ts\" \"src/**/*.test.ts\"",
		"check-manifest": "node ./scripts/check-manifest.mjs",
		"package": "vsce package --no-dependencies --out tab-browser-ultimate.vsix",
		"publish:ovsx": "npm run package && ovsx publish tab-browser-ultimate.vsix",
		"verify-pat": "ovsx verify-pat DenysDavydov",
		"download-api": "dts dev",
		"vscode:prepublish": "npm run compile",
		"clean-ext": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\""
	},
	"devDependencies": {
		"@types/node": "24.x",
		"@types/vscode": "1.85.0",
		"@vscode/codicons": "^0.0.36",
		"@vscode/dts": "^0.4.1",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.2",
		"npm-run-all2": "^9.0.3",
		"ovsx": "^1.1.1",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
