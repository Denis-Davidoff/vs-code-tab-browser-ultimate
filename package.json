				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-grape-light.svg",
					"dark": "media/icons/crosshair-grape-dark.svg"
				}
			},
			{
				"command": "aiBrowser.connectClaudeCode",
				"title": "%command.connectClaudeCode.title%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "aiBrowser.connectCodex",
				"title": "%command.connectCodex.title%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "aiBrowser.checkMcpConnection",
				"title": "%command.checkMcpConnection.title%",
				"category": "%displayName%",
				"icon": "$(pulse)"
			},
			{
				"command": "aiBrowser.enableBrowserApi",
				"title": "%command.enableBrowserApi.title%",
				"category": "%displayName%",
				"icon": "$(shield)"
			},
			{
				"command": "aiBrowser.statusMenu",
				"title": "%command.statusMenu.title%",
				"category": "%displayName%",
