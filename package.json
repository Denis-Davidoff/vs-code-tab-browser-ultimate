					"id": "aiBrowserChat",
					"title": "%viewsContainer.chat.title%",
					"icon": "media/chat-activity.svg"
				}
			]
		},
		"views": {
			"aiBrowserChat": [
				{
					"type": "webview",
					"id": "aiBrowser.chat",
					"name": "%view.chat.name%",
					"when": "!aiBrowser.chatUnsupported"
				}
			]
		},
		"configuration": [
			{
				"title": "AI Browser",
				"properties": {
					"aiBrowser.useIntegratedBrowser": {
						"type": "boolean",
						"default": true,
						"title": "Use Integrated Browser",
						"description": "%configuration.useIntegratedBrowser.description%"
					},
					"aiBrowser.focusLockIndicator.enabled": {
						"type": "boolean",
						"default": true,
						"title": "Focus Lock Indicator Enabled",
						"description": "%configuration.focusLockIndicator.enabled.description%"
					},
					"aiBrowser.searchEngine": {
						"type": "string",
						"enum": [
							"none",
							"bing",
							"google",
							"yahoo",
							"duckduckgo"
						],
						"default": "google",
						"title": "Search Engine",
						"description": "%configuration.searchEngine.description%"
					},
					"aiBrowser.mcp.enabled": {
						"type": "boolean",
						"default": true,
						"title": "MCP Server Enabled",
						"markdownDescription": "%configuration.mcp.enabled.description%"
					},
					"aiBrowser.updateCheck.enabled": {
						"type": "boolean",
						"default": true,
						"title": "Check For Updates",
						"markdownDescription": "%configuration.updateCheck.enabled.description%"
					},
					"aiBrowser.mcp.port": {
						"type": "integer",
						"default": 43110,
						"minimum": 1024,
						"maximum": 65535,
						"title": "MCP Server Port",
						"markdownDescription": "%configuration.mcp.port.description%"
					},
					"aiBrowser.logins.enabled": {
						"type": "boolean",
						"default": true,
						"scope": "application",
						"title": "Saved Logins",
						"markdownDescription": "%configuration.logins.enabled.description%"
					},
					"aiBrowser.logins.offerToSave": {
						"type": "boolean",
						"default": true,
						"scope": "application",
						"title": "Offer to Save Logins",
						"markdownDescription": "%configuration.logins.offerToSave.description%"
					},
					"aiBrowser.logins.showSuggestions": {
						"type": "boolean",
						"default": true,
						"scope": "application",
						"title": "Suggest Saved Logins",
