{
	"name": "tab-browser-ultimate",
	"displayName": "AI Browser🏆 Claude + Codex",
	"description": "Embedded browser tab with AI capabilities, Claude and Codex integration",
	"version": "0.5.26",
	"enabledApiProposals": [
		"externalUriOpener",
		"browser"
	],
	"icon": "media/icon.png",
	"publisher": "DenysDavydov",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Denis-Davidoff/vs-code-tab-browser-ultimate.git"
	},
	"bugs": {
		"url": "https://github.com/Denis-Davidoff/vs-code-tab-browser-ultimate/issues"
	},
	"homepage": "https://github.com/Denis-Davidoff/vs-code-tab-browser-ultimate#readme",
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./out/extension",
	"categories": [
		"AI",
		"Other"
	],
	"keywords": [
		"browser",
		"embedded browser",
		"copilot browser",
		"ai claude",
		"ai codex",
		"ai copilot",
		"ai chatgpt",
		"ai chat gpt",
		"ai panel",
		"browser panel",
		"simple browser",
		"tab browser",
		"ai browser",
		"chatgpt browser",
		"claude browser",
		"claude mcp",
		"codex mcp",
		"codex",
		"claude",
		"chatgpt",
		"chat gpt",
		"chat gpt mcp",
		"codex browser",
		"ai chat browser",
		"ai tab browser",
		"frontend browser",
		"frontend ai",
		"frontend chatgpt",
		"frontend claude",
		"preview",
		"webview",
		"ai",
		"assistant",
		"devtools",
		"localhost",
		"inspect element"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"activationEvents": [
		"onCommand:aiBrowser.show",
		"onCommand:aiBrowser.api.open",
		"onCommand:aiBrowser.copyElementXPath",
		"onOpenExternalUri:http",
		"onOpenExternalUri:https",
		"onWebviewPanel:aiBrowser.view",
		"onCommand:aiBrowser.copyElement",
		"onCommand:aiBrowser.copyElementCssPath",
		"onStartupFinished",
		"onCommand:aiBrowser.connectClaudeCode",
		"onCommand:aiBrowser.connectCodex",
		"onCommand:aiBrowser.checkMcpConnection",
		"onCommand:aiBrowser.enableBrowserApi",
		"onCommand:aiBrowser.statusMenu",
		"onCommand:aiBrowser.addElementToClaudeCode",
		"onCommand:aiBrowser.addCssPathToClaudeCode",
		"onCommand:aiBrowser.addXPathToClaudeCode",
		"onCommand:aiBrowser.addElementToCodex",
		"onCommand:aiBrowser.addCssPathToCodex",
		"onCommand:aiBrowser.addXPathToCodex",
		"onCommand:aiBrowser.copyScreenshot",
		"onCommand:aiBrowser.copyFullScreenshot",
		"onCommand:aiBrowser.repeat.element",
		"onCommand:aiBrowser.repeat.cssPath",
		"onCommand:aiBrowser.repeat.xpath",
		"onCommand:aiBrowser.repeat.claude.element",
		"onCommand:aiBrowser.repeat.claude.cssPath",
		"onCommand:aiBrowser.repeat.claude.xpath",
		"onCommand:aiBrowser.repeat.codex.element",
		"onCommand:aiBrowser.repeat.codex.cssPath",
		"onCommand:aiBrowser.repeat.codex.xpath",
		"onCommand:aiBrowser.shareTab",
		"onCommand:aiBrowser.stopSharingTab",
		"onCommand:aiBrowser.shareTabWithClaudeCode",
		"onCommand:aiBrowser.shareTabWithCodex",
		"onCommand:aiBrowser.copyElementCssLocation",
		"onCommand:aiBrowser.addCssLocationToClaudeCode",
		"onCommand:aiBrowser.addCssLocationToCodex",
		"onCommand:aiBrowser.repeat.cssLocation",
		"onCommand:aiBrowser.repeat.claude.cssLocation",
		"onCommand:aiBrowser.repeat.codex.cssLocation"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "aiBrowser.show",
				"title": "Show",
				"category": "AI Browser"
			},
			{
				"command": "aiBrowser.copyElementXPath",
				"title": "%command.copyElementXPath.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-green-light.svg",
					"dark": "media/icons/crosshair-green-dark.svg"
				}
			},
			{
				"command": "aiBrowser.copyElement",
				"title": "%command.copyElement.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-red-light.svg",
					"dark": "media/icons/crosshair-red-dark.svg"
				}
			},
			{
				"command": "aiBrowser.copyElementCssPath",
				"title": "%command.copyElementCssPath.title%",
				"category": "%displayName%",
				"icon": {
					"light": "media/icons/crosshair-blue-light.svg",
					"dark": "media/icons/crosshair-blue-dark.svg"
				}
			},
			{
				"command": "aiBrowser.copyElementCssLocation",
