DATABASE_URL=postgresql://exchange:exchange@localhost:55432/exchange
# For a shared database, provision a dedicated role whose search_path names
# only this schema. Leave unset for the existing local public schema.
# DATABASE_SCHEMA=exchange
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set true to disable Origin checks locally (ignored when NODE_ENV=production).
LOCAL_DISABLE_ORIGIN_CHECK=false

# Security journal: single API instance; retention includes IP addresses and device metadata.
AUDIT_RETENTION_DAYS=90
# Exact socket peer IPs of proxies that OVERWRITE X-Forwarded-For. Empty = ignore headers.
AUDIT_TRUSTED_PROXIES=
# Comma-separated account IDs permitted to view the server-wide security journal.
SECURITY_ADMIN_IDS=
# Optional private modules; empty keeps the public server unrestricted.
# Explicitly enabled but missing/incompatible modules stop startup.
EXCHANGE_PLUGINS=
# EXCHANGE_PLUGINS=sessions,commercial
