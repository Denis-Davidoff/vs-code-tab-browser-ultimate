{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run AI Browser Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}",
				// Required: the extension uses the proposed `externalUriOpener` API.
				"--enable-proposed-api=DenysDavydov.ai-browser"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "npm: compile"
		}
	]
}
